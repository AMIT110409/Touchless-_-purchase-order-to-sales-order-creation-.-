# ============================================================
# .env.example — Copy this file to .env and fill in your values
# NEVER commit the actual .env file (it contains real secrets)
# ============================================================

# Microsoft Graph API (Azure App Registration)
MS_GRAPH_CLIENT_ID=your_azure_app_client_id
MS_GRAPH_TENANT_ID=your_azure_tenant_id
MS_GRAPH_CLIENT_SECRET=your_azure_app_client_secret
TARGET_EMAIL_USER=salesorders@yourdomain.com

# Azure Blob Storage
AZURE_BLOB_URL=https://yourstorageaccount.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
AZURE_TABLE_FALLBACK_SQLITE=your_value_here
AZURE_QUEUE_URL=https://yourstorageaccount.queue.core.windows.net

# Celonis + Azure Blob: Reference Table Storage
AZURE_BLOB_CONTAINER_CELONIS=your_blob_container_name
CELONIS_SHEET2_BLOB=sheet2_customer_master.parquet
CELONIS_SHEET3_BLOB=sheet3_order_mapping.parquet
CELONIS_CACHE_TTL_HOURS=24

# LLM Configuration (Anthropic / Claude)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Roborana & Exception Routing Mailboxes
ROBONA_SERVICE_MAILBOX=robona-service@yourdomain.com
DEFAULT_CS_EMAIL=customerservice@yourdomain.com

# Celonis + Azure Blob: SO Creation Results (Stage 2 Feedback Table)
# Set SO_RESULTS_TABLE to the exact Celonis table/view name where the
# Action Flow writes SAP Sales Order creation outcomes.
CELONIS_SO_RESULTS_BLOB=your_so_results_blob_name
SO_RESULTS_TABLE=o_custom_PoExtractionResults

# Celonis Connection
CELONIS_URL=https://yourteam.celonis.cloud
CELONIS_API_TOKEN=your_celonis_api_token
CELONIS_POOL_ID=your_celonis_data_pool_id
CELONIS_DATA_MODEL_ID=your_celonis_data_model_id
